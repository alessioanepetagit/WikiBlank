# Porta del server REST
PORT=3000
# Segreto per firmare i JWT (OBBLIGATORIO in produzione: stringa lunga e casuale)
JWT_SECRET=cambia-questo-segreto-con-una-stringa-lunga-e-casuale
JWT_EXPIRES_IN=24h
# File del database SQLite (usare :memory: per un database temporaneo)
DB_STORAGE=./data/wikiblank.sqlite
# Origini autorizzate da CORS (separate da virgola)
FRONTEND_ORIGIN=http://localhost:4200
# Sorgente degli articoli: "wikipedia" (API MediaWiki) oppure "fixtures" (articoli locali, per demo/test offline)
WIKI_SOURCE=wikipedia
WIKI_LANG=it
# Solo con WIKI_SOURCE=fixtures: "random" oppure "fixed" (sempre l'articolo "Vesuvio", usato dai test E2E)
WIKI_FIXTURE_MODE=random
# Rate limiting (disattivarlo solo per i test automatici)
RATE_LIMIT_ENABLED=true
