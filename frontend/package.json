{
  "name": "wikiblank-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "e2e": "playwright test",
    "e2e:api": "playwright test --project=api",
    "e2e:web": "playwright test --project=chromium --project=firefox",
    "e2e:report": "playwright show-report"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
